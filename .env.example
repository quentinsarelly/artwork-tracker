CAMELOT_SOAP_URL=
CAMELOT_USERNAME=
CAMELOT_PASSWORD=
CAMELOT_CLIENT=
CAMELOT_TRADING_PARTNER=
CAMELOT_INTERFACE_PROFILE=

# Google Sheets push (scripts/push_to_sheets.py) — either ID or name; ID preferred
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# ShipHero (MX 3PL) API — same refresh token inventory-snapshot uses for mx_3pl
SHIPHERO_REFRESH_TOKEN=

# OAuth client (Desktop app) credentials for the Sheets push.
# Alternatively skip these and put the downloaded client-secret JSON at
# ~/.config/gspread/credentials.json instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
