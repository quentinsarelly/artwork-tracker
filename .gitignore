# OAuth client secrets and cached tokens must never be committed
client_secret*.json
authorized_user.json

.env
__pycache__/
*.pyc
.venv/
venv/
*:Zone.Identifier

# Reference copy of the API docs (canonical copy lives in apisandbox/camelot/)
API - API Documentation*.pdf

# Manual Camelot/ShipHero exports, mapping data, and generated reports contain live business data
data/camelot_exports/*
!data/camelot_exports/.gitkeep
data/shiphero_exports/*
!data/shiphero_exports/.gitkeep
data/shiphero_sku_totals/*
!data/shiphero_sku_totals/.gitkeep
data/mapping/*
!data/mapping/.gitkeep
reports/*
!reports/.gitkeep
